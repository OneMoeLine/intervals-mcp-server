{
  "name": "intervals-mcp-server",
  "version": "1.0.0",
  "description": "MCP server exposing Intervals.icu training data - activities, streams, power curves, wellness and the training calendar - to Claude and other MCP clients.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "intervals.icu",
    "cycling",
    "running",
    "training",
    "fitness"
  ],
  "homepage": "https://github.com/OneMoeLine/intervals-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/OneMoeLine/intervals-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneMoeLine/intervals-mcp-server.git"
  },
  "author": "Travis Moe (https://github.com/OneMoeLine)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "intervals-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "pretest": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^3.2.7"
  }
}
